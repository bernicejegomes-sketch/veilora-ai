# Server Port
PORT=3000

# Permitted CORS Origin for Frontend (default: Vite dev server)
FRONTEND_URL=http://localhost:5173

# Database file location (e.g., ./data/incognito.db or /data/incognito.db for persistent volumes)
DATABASE_PATH=./data/incognito.db

# Authoritative server timezone for serverDay calculation (default: Asia/Kolkata)
SERVER_TIMEZONE=Asia/Kolkata

# Demo Mode Configuration
# Explicitly enable synthetic DEV001-DEV030 roster and dev OTP for hackathon demonstration.
# Default: false (disabled by default for production safety). Set to true only for demos.
DEMO_MODE=false

# --- AI Insights (optional, privacy-preserving) ---
# AI analysis is BEST-EFFORT and DISABLED by default. When disabled, anonymous
# submissions still work; only aggregate counters are recorded. No API key ships
# with this repo -- add your own. Only the anonymous complaint text + topic are
# ever sent to the provider; identity data is NEVER sent, and raw text is never stored.
#
# Provider: "openai" (any OpenAI-compatible Chat Completions API, e.g. Groq) or "gemini".
AI_PROVIDER=openai
# API key for the OpenAI-compatible provider (e.g. a Groq key). Leave empty to disable AI.
AI_API_KEY=
# API key for Google Gemini, used only when AI_PROVIDER=gemini. Leave empty to disable AI.
GEMINI_API_KEY=
# Optional overrides (defaults shown):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
# AI_TIMEOUT_MS=8000
# AI_MAX_RETRIES=1
# AI_MAX_INPUT_CHARS=4000
